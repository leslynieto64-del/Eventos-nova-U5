ometry x="666.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_Fin" value="Evento cancelado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=end;symbol=general;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="Lane_SP07_Coord"><mxGeometry x="1728.0" y="47.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP07_Informar" value="Informar el resultado al Coordinador" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP07_Admin"><mxGeometry x="1266.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_Inicio" value="Cancelación registrada por el Coordinador" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=standard;symbol=general;fillColor=#FFFFFF;strokeColor=#263238;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#263238;" vertex="1" parent="Lane_SP07_Coord"><mxGeometry x="128.0" y="47.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP07_Resultado" value="Registrar el resultado: pagos realizados, saldo pendiente y constancia de no reembolso" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP07_Admin"><mxGeometry x="1066.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_Revisar" value="Revisar el contrato y los pagos realizados del evento" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP07_Admin"><mxGeometry x="866.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_Seguimiento" value="Dar seguimiento a la cancelación" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP07_Coord"><mxGeometry x="1466.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_Senal" value="Evento cancelado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=throwing;symbol=signal;fillColor=#F8CFC7;strokeColor=#B3261E;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#B3261E;" vertex="1" parent="Lane_SP07_Coord"><mxGeometry x="328.0" y="47.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="-70.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP07_NotaSol" value="Con la señal «Evento cancelado» (BN-008): caso A, cada solicitud de cambio, servicio adicional o sustitución que sigue en trámite se cierra con el motivo «Evento cancelado»; caso B, una operación ya confirmada que todavía no se aplicó no se aplica al Evento cancelado, conserva su confirmación y queda registrada para revisión. Las operaciones ya aplicadas no cambian (ver SP-03, SP-04 y SP-05)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="Lane_SP07_Coord"><mxGeometry x="961.0" y="150.0" width="560.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_NotaSaldo" value="La cancelación no anula el saldo pendiente del contrato original: queda registrado y su exigibilidad se rige por el contrato. No se crea un proceso de cobro adicional y no se generan reembolsos (BN-008, SE-012)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" parent="Lane_SP07_Admin"><mxGeometry x="866.0" y="160.0" width="470.0" height="70.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_F01" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP07_Inicio" target="SP07_Senal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_F02" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP07_Senal" target="SP07_Comunicar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_F03" value="" style="edgeStyle=none;html=1;rounded=0;fontFamily=Arial;fontSize=11;fontColor=#22242A;labelBackgroundColor=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=8;strokeColor=#263238;strokeWidth=1.5;" edge="1" parent="1" source="SP07_Comunicar" target="SP07_Constancia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="SP07_F04" value="" style="edgeStyle=none;