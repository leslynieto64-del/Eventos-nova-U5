ize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP06_Coord"><mxGeometry x="3066.0" y="150.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_RegLiquidacion" value="Registrar y verificar la liquidación, aunque sea después del plazo, e informar al Coordinador" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP06_Admin"><mxGeometry x="2266.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Retomar" value="Retomar la organización del evento y las solicitudes detenidas que cumplan sus condiciones" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#0F766E;fillColor=#A6E1D8;strokeColor=#0F766E;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP06_Coord"><mxGeometry x="2666.0" y="150.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Revisar" value="Revisar los pagos y comprobar si el Cliente los efectuó dentro del plazo" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP06_Admin"><mxGeometry x="1866.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Senal" value="Saldo vencido regularizado" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=throwing;symbol=signal;fillColor=#FFFFFF;strokeColor=#263238;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#263238;" vertex="1" parent="Lane_SP06_Admin"><mxGeometry x="2528.0" y="47.0" width="36.0" height="36.0" as="geometry"><mxPoint x="0.0" y="2.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_UEsp" value="" style="shape=mxgraph.bpmn.gateway2;html=1;perimeter=rhombusPerimeter;outlineConnect=0;outline=none;symbol=none;fillColor=#FFFFFF;strokeColor=#263238;strokeWidth=2;" vertex="1" parent="Lane_SP06_Coord"><mxGeometry x="721.0" y="40.0" width="50.0" height="50.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_Vence" value="Fecha límite vencida sin que el Cliente haya pagado el saldo" style="shape=mxgraph.bpmn.event;html=1;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;outline=catching;symbol=timer;fillColor=#FFF2A8;strokeColor=#8F6C00;whiteSpace=wrap;labelWidth=94;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Arial;fontSize=11;fontColor=#8F6C00;" vertex="1" parent="Lane_SP06_Coord"><mxGeometry x="928.0" y="177.0" width="36.0" height="36.0" as="geometry"><mxPoint x="-72.5" y="-40.0" as="offset"/></mxGeometry></mxCell><mxCell id="SP06_Verificar" value="Registrar y verificar el pago del saldo" style="rounded=1;absoluteArcSize=1;arcSize=20;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#5B4A9B;fillColor=#D6C9F1;strokeColor=#5B4A9B;strokeWidth=2;spacing=6;" vertex="1" parent="Lane_SP06_Admin"><mxGeometry x="1066.0" y="20.0" width="160.0" height="90.0" as="geometry"></mxGeometry></mxCell><mxCell id="SP06_NotaCanc" value="La cancelación no es automática: la registra el Coordinador. Un pago efectuado después de las 24 horas no la evita; uno efectuado dentro de ellas cuenta aunque Administración lo registre o verifique después. Si el evento inicia antes de registrarla, ya no procede y el saldo vencido y los cargos moratorios se conservan como adeudo (BN-005)." style="shape=mxgraph.flowchart.annotation_1;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#22242A;align=left;verticalAlign=middle;spacingLeft=8;fillColor=none;strokeColor=#263238;strokeWidth=1.5;" vertex="1" paren