<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_SP07" targetNamespace="https://eventosnova.example/bpmn" exporter="Eventos Nova (generador del equipo)" exporterVersion="1.0">
  <bpmn:signal id="Signal_EventoCancelado" name="Evento cancelado" />
  <bpmn:collaboration id="Collab_SP07">
    <bpmn:documentation>Comunicación de la cancelación, efecto sobre las solicitudes del Evento, revisión administrativa del contrato y de los pagos y política de no reembolso (BN-005, BN-008, SE-007, SE-009, SE-012; US-026 a US-028; CA-027, CA-084 a CA-091, CA-095).</bpmn:documentation>
    <bpmn:participant id="Part_SP07_Cliente" name="Cliente" />
    <bpmn:participant id="Part_SP07_Proveedor" name="Proveedor" />
    <bpmn:participant id="Part_SP07_EN" name="Eventos Nova" processRef="Proc_SP07_Cancelacion" />
    <bpmn:messageFlow id="SP07_M01" name="Cancelación y política de no reembolso" sourceRef="SP07_Comunicar" targetRef="Part_SP07_Cliente" />
    <bpmn:messageFlow id="SP07_M02" name="Cancelación del evento" sourceRef="SP07_Comunicar" targetRef="Part_SP07_Proveedor" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_SP07_Cancelacion" name="Gestión de la cancelación del evento" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SP07">
      <bpmn:lane id="Lane_SP07_Coord" name="Coordinador">
        <bpmn:flowNodeRef>SP07_Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Senal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Comunicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Constancia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Seguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SP07_Admin" name="Administración">
        <bpmn:flowNodeRef>SP07_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP07_Informar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SP07_Inicio" name="Cancelación registrada por el Coordinador">
      <bpmn:documentation>Por solicitud procedente del Cliente (CA-087) o por falta de regularización del saldo vencido (CA-027).</bpmn:documentation>
      <bpmn:outgoing>SP07_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="SP07_Senal" name="Evento cancelado">
      <bpmn:documentation>BN-008: la señal llega a cada solicitud del Evento (SP-03, SP-04, SP-05).</bpmn:documentation>
      <bpmn:incoming>SP07_F01</bpmn:incoming>
      <bpmn:outgoing>SP07_F02</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SP07_Senal_def" signalRef="Signal_EventoCancelado" />
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="SP07_Comunicar" name="Comunicar la cancelación al Cliente, a Administración y a los proveedores e informar la política de no reembolso">
      <bpmn:documentation>BN-008; CA-087, SE-009</bpmn:documentation>
      <bpmn:incoming>SP07_F02</bpmn:incoming>
      <bpmn:outgoing>SP07_F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP07_Constancia" name="Dejar constancia de la cancelación y de las comunicaciones realizadas">
      <bpmn:documentation>CA-087, SE-007</bpmn:documentation>
      <bpmn:incoming>SP07_F03</bpmn:incoming>
      <bpmn:outgoing>SP07_F04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP07_Revisar" name="Revisar el contrato y los pagos realizados del evento">
      <bpmn:documentation>CA-089, CA-090 (US-028)</bpmn:documentation>
      <bpmn:incoming>SP07_F04</bpmn:incoming>
      <bpmn:outgoing>SP07_F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP07_Resultado" name="Registrar el resultado: pagos realizados, saldo pendiente y constancia de no reembolso">
      <bpmn:documentation>CA-091: sin agregar motivos de rechazo.</bpmn:documentation>
      <bpmn:incoming>SP07_F05</bpmn:incoming>
      <bpmn:outgoing>SP07_F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP07_Informar" name="Informar el resultado al Coordinador">
      <bpmn:documentation>CA-091</bpmn:documentation>
      <bpmn:incoming>SP07_F06</bpmn:incoming>
      <bpmn:outgoing>SP07_F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SP07_Seguimiento" name="Dar seguimiento a la cancelación">
      <bpmn:documentation>SE-009 (US-027)</bpmn:documentation>
      <bpmn:incoming>SP07_F07</bpmn:incoming>
      <bpmn:outgoing>SP07_F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SP07_Fin" name="Evento cancelado">
      <bpmn:documentation>CA-095: un Evento Cancelado no pasa a Finalizado.</bpmn:documentation>
      <bpmn:incoming>SP07_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SP07_F01" sourceRef="SP07_Inicio" targetRef="SP07_Senal" />
    <bpmn:sequenceFlow id="SP07_F02" sourceRef="SP07_Senal" targetRef="SP07_Comunicar" />
    <bpmn:sequenceFlow id="SP07_F03" sourceRef="SP07_Comunicar" targetRef="SP07_Constancia" />
    <bpmn:sequenceFlow id="SP07_F04" sourceRef="SP07_Constancia" targetRef="SP07_Revisar" />
    <bpmn:sequenceFlow id="SP07_F05" sourceRef="SP07_Revisar" targetRef="SP07_Resultado" />
    <bpmn:sequenceFlow id="SP07_F06" sourceRef="SP07_Resultado" targetRef="SP07_Informar" />
    <bpmn:sequenceFlow id="SP07_F07" sourceRef="SP07_Informar" targetRef="SP07_Seguimiento" />
    <bpmn:sequenceFlow id="SP07_F08" sourceRef="SP07_Seguimiento" targetRef="SP07_Fin" />
    <bpmn:textAnnotation id="SP07_NotaSol"><bpmn:text>Con la señal «Evento cancelado» (BN-008): caso A, cada solicitud de cambio, servicio adicional o sustitución que sigue en trámite se cierra con el motivo «Evento cancelado»; caso B, una operación ya confirmada que todavía no se aplicó no se aplica al Evento cancelado, conserva su confirmación y queda registrada para revisión. Las operaciones ya aplicadas no cambian (ver SP-03, SP-04 y SP-05).</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="SP07_NotaSaldo"><bpmn:text>La cancelación no anula el saldo pendiente del contrato original: queda registrado y su exigibilidad se rige por el contrato. No se crea un proceso de cobro adicional y no se generan reembolsos (BN-008, SE-012).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="SP07_NotaSaldo_A" associationDirection="None" sourceRef="SP07_Resultado" targetRef="SP07_NotaSaldo" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_SP07" name="Gestión de la cancelación del evento">
    <bpmndi:BPMNPlane id="Plane_SP07" bpmnElement="Collab_SP07">
      <bpmndi:BPMNShape id="Part_SP07_Cliente_di" bpmnElement="Part_SP07_Cliente" isHorizontal="true" bioc:fill="#D4E7FA" color:background-color="#D4E7FA" bioc:stroke="#1E5A9C" color:border-color="#1E5A9C"><dc:Bounds x="0" y="0" width="1892" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_SP07_Proveedor_di" bpmnElement="Part_SP07_Proveedor" isHorizontal="true" bioc:fill="#FCE2BC" color:background-color="#FCE2BC" bioc:stroke="#A85E00" color:border-color="#A85E00"><dc:Bounds x="0" y="690" width="1892" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Part_SP07_EN_di" bpmnElement="Part_SP07_EN" isHorizontal="true" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="0" y="120" width="1892" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SP07_Coord_di" bpmnElement="Lane_SP07_Coord" isHorizontal="true" bioc:fill="#A9E0D8" color:background-color="#A9E0D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="36" y="120" width="1856" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SP07_Admin_di" bpmnElement="Lane_SP07_Admin" isHorizontal="true" bioc:fill="#D2C3F0" color:background-color="#D2C3F0" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="36" y="380" width="1856" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Inicio_di" bpmnElement="SP07_Inicio" bioc:fill="#FFFFFF" color:background-color="#FFFFFF" bioc:stroke="#263238" color:border-color="#263238"><dc:Bounds x="164" y="167" width="36" height="36" /><bpmndi:BPMNLabel color:color="#263238"><dc:Bounds x="127" y="207" width="110" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Senal_di" bpmnElement="SP07_Senal" bioc:fill="#F8CFC7" color:background-color="#F8CFC7" bioc:stroke="#B3261E" color:border-color="#B3261E"><dc:Bounds x="364" y="167" width="36" height="36" /><bpmndi:BPMNLabel color:color="#B3261E"><dc:Bounds x="327" y="135" width="110" height="20" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Comunicar_di" bpmnElement="SP07_Comunicar" bioc:fill="#A6E1D8" color:background-color="#A6E1D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="502" y="140" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Constancia_di" bpmnElement="SP07_Constancia" bioc:fill="#A6E1D8" color:background-color="#A6E1D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="702" y="140" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Revisar_di" bpmnElement="SP07_Revisar" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="902" y="400" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Resultado_di" bpmnElement="SP07_Resultado" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="1102" y="400" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Informar_di" bpmnElement="SP07_Informar" bioc:fill="#D6C9F1" color:background-color="#D6C9F1" bioc:stroke="#5B4A9B" color:border-color="#5B4A9B"><dc:Bounds x="1302" y="400" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Seguimiento_di" bpmnElement="SP07_Seguimiento" bioc:fill="#A6E1D8" color:background-color="#A6E1D8" bioc:stroke="#0F766E" color:border-color="#0F766E"><dc:Bounds x="1502" y="140" width="160" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_Fin_di" bpmnElement="SP07_Fin" bioc:fill="#F8CFC7" color:background-color="#F8CFC7" bioc:stroke="#B3261E" color:border-color="#B3261E"><dc:Bounds x="1764" y="167" width="36" height="36" /><bpmndi:BPMNLabel color:color="#B3261E"><dc:Bounds x="1727" y="207" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_NotaSol_di" bpmnElement="SP07_NotaSol"><dc:Bounds x="997.0" y="270.0" width="560" height="90" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP07_NotaSaldo_di" bpmnElement="SP07_NotaSaldo"><dc:Bounds x="902.0" y="540.0" width="470" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SP07_F01_di" bpmnElement="SP07_F01"><di:waypoint x="200" y="185" /><di:waypoint x="364" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F02_di" bpmnElement="SP07_F02"><di:waypoint x="400" y="185" /><di:waypoint x="502" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F03_di" bpmnElement="SP07_F03"><di:waypoint x="662" y="185" /><di:waypoint x="702" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F04_di" bpmnElement="SP07_F04"><di:waypoint x="862" y="185" /><di:waypoint x="982" y="185" /><di:waypoint x="982" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F05_di" bpmnElement="SP07_F05"><di:waypoint x="1062" y="445" /><di:waypoint x="1102" y="445" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F06_di" bpmnElement="SP07_F06"><di:waypoint x="1262" y="445" /><di:waypoint x="1302" y="445" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F07_di" bpmnElement="SP07_F07"><di:waypoint x="1462" y="445" /><di:waypoint x="1582" y="445" /><di:waypoint x="1582" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_F08_di" bpmnElement="SP07_F08"><di:waypoint x="1662" y="185" /><di:waypoint x="1764" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_M01_di" bpmnElement="SP07_M01" bioc:stroke="#5F6B73" color:border-color="#5F6B73"><di:waypoint x="582" y="140" /><di:waypoint x="582" y="70" /><bpmndi:BPMNLabel><dc:Bounds x="587" y="75" width="95" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_M02_di" bpmnElement="SP07_M02" bioc:stroke="#5F6B73" color:border-color="#5F6B73"><di:waypoint x="582" y="230" /><di:waypoint x="582" y="690" /><bpmndi:BPMNLabel><dc:Bounds x="587" y="645" width="95" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SP07_NotaSaldo_A_di" bpmnElement="SP07_NotaSaldo_A"><di:waypoint x="1182" y="490" /><di:waypoint x="912" y="540" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>